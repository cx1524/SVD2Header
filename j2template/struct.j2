/**
  * @brief {{peripheral.find('description').text}} ({{peripheral.find('name').text}})
  */

typedef struct
{
{%- set ns = namespace(register_address=0, reserved_index=0) %}
{%- for register in peripheral.findall('./registers/register')|default([]) %}
    {%- set current_offset = register.find('addressOffset').text|int(base=16) %}
    {%- if current_offset != ns.register_address %}
        {%- set offset = (current_offset - ns.register_address) // 4 %}
        {%- if offset < 2 %}
       uint32_t  RESERVED{{ ns.reserved_index }};
        {%- else %}
       uint32_t  RESERVED{{ ns.reserved_index }}[{{ offset }}];
        {%- endif %}
        {%- set ns.reserved_index = ns.reserved_index + 1 %}
        {%- set ns.register_address = current_offset %}
    {%- endif %}
    {%- if register.get('union') == None %}
  __IO uint32_t  {{"%-30s"|format("%s;"|format(register.find('name').text))}} /*!< {{"%-73s"|format("(@%s) %s"|format("0x%08X"|format(current_offset), register.find('description').text))}} */
    {%- set ns.register_address = current_offset + 4 %}
    {%- elif register.get('union') == "Start" %}
  union
  {
    __IO uint32_t  {{"%-28s"|format("%s;"|format(register.find('name').text))}} /*!< {{"%-73s"|format("(@%s) %s"|format("0x%08X"|format(current_offset), register.find('description').text))}} */
    {%- elif register.get('union') == "Continue" %}
    __IO uint32_t  {{"%-28s"|format("%s;"|format(register.find('name').text))}} /*!< {{"%-73s"|format("(@%s) %s"|format("0x%08X"|format(current_offset), register.find('description').text))}} */
    {%- elif register.get('union') == "Stop" %}
    __IO uint32_t  {{"%-28s"|format("%s;"|format(register.find('name').text))}} /*!< {{"%-73s"|format("(@%s) %s"|format("0x%08X"|format(current_offset), register.find('description').text))}} */
    {%- set ns.register_address = current_offset + 4 %}
  };
    {%- endif %}
{%- endfor %}
} {{ peripheral.get("typedef") }};
